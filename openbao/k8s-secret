#!/usr/bin/env bash
# k8s-secret: Read K8s secrets using SA identity.
#
# Usage:
#   k8s-secret <name>              # dump all keys
#   k8s-secret <name> <key>        # single key
#   k8s-secret export <name>       # as export lines
#   k8s-secret export <name> KEY   # single key as export
#   k8s-secret list                # list agent secrets
#   k8s-secret whoami              # show SA identity
#   k8s-secret login [duration]    # refresh token
#
# Environment:
#   K8S_AGENT        ServiceAccount name (default: readonly)
#   K8S_NAMESPACE    Namespace (default: ai-agents)
#   K8S_SA_TOKEN     Pre-existing token (skip kubectl)

set -euo pipefail

AGENT="${K8S_AGENT:-readonly}"
NS="${K8S_NAMESPACE:-ai-agents}"
LABEL="app.kubernetes.io/part-of=opencode-agents"
CACHE_DIR="$HOME/.cache/opencode-k8s"
TOKEN_CACHE="$CACHE_DIR/$AGENT.json"

die() { echo "k8s-secret: $*" >&2; exit 1; }

get_token() {
  # Use pre-existing token if set
  if [ -n "${K8S_SA_TOKEN:-}" ]; then
    echo "$K8S_SA_TOKEN"
    return
  fi

  # Check cache
  if [ -f "$TOKEN_CACHE" ]; then
    local expiry
    expiry=$(jq -r .expiry "$TOKEN_CACHE" 2>/dev/null)
    if [ -n "$expiry" ]; then
      local now exp_epoch now_epoch
      exp_epoch=$(date -d "$expiry" +%s 2>/dev/null || echo 0)
      now_epoch=$(date +%s)
      if [ "$exp_epoch" -gt "$now_epoch" ]; then
        jq -r .token "$TOKEN_CACHE"
        return
      fi
    fi
  fi

  # Generate via kubectl
  local duration="${1:-1h}"
  local token
  token=$(kubectl create token "$AGENT" -n "$NS" --duration="$duration")

  # Cache it
  mkdir -p "$CACHE_DIR"
  local expiry
  expiry=$(date -u -d "+${duration} -30 seconds" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-30S -v+${duration#*[0-9]} +%Y-%m-%dT%H:%M:%SZ)
  jq -n \
    --arg token "$token" \
    --arg expiry "$expiry" \
    --arg agent "$AGENT" \
    --arg ns "$NS" \
    '{token: $token, expiry: $expiry, agent: $agent, namespace: $ns}' \
    > "$TOKEN_CACHE"
  echo "$token"
}

k8s_get() {
  local token
  token=$(get_token)
  curl -sf -H "Authorization: Bearer $token" \
    "https://127.0.0.1:38039/api/v1/namespaces/$NS/secrets/$1" \
    --cacert <(kubectl config view --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}' | base64 -d)
}

k8s_list() {
  local token
  token=$(get_token)
  curl -sf -H "Authorization: Bearer $token" \
    "https://127.0.0.1:38039/api/v1/namespaces/$NS/secrets?labelSelector=$LABEL" \
    --cacert <(kubectl config view --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}' | base64 -d)
}

decode_value() {
  echo "$1" | base64 -d 2>/dev/null || echo "$1"
}

# ---- Commands ----

cmd_read() {
  local name="${1:-}" key="${2:-}"
  [ -n "$name" ] || die "Usage: k8s-secret <name> [key]"

  local data
  data=$(k8s_get "$name")

  if [ -n "$key" ]; then
    local val
    val=$(echo "$data" | jq -r ".data.\"$key\" // empty")
    [ -n "$val" ] || die "Key '$key' not found in secret $name"
    decode_value "$val"
  else
    echo "$data" | jq -r '.data | to_entries[] | "\(.key) = \(decode_value(.value))"'
  fi
}

cmd_export() {
  local name="${1:-}" key="${2:-}"
  [ -n "$name" ] || die "Usage: k8s-secret export <name> [key]"

  local data
  data=$(k8s_get "$name")

  if [ -n "$key" ]; then
    local val var
    val=$(echo "$data" | jq -r ".data.\"$key\" // empty")
    [ -n "$val" ] || die "Key '$key' not found"
    var=$(echo "$key" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
    echo "export $var=$(decode_value "$val")"
  else
    echo "$data" | jq -r '.data | to_entries[] | "export \(.key | ascii_upcase | gsub("-";"_"))=\(decode_value(.value))"'
  fi
}

cmd_list() {
  local data
  data=$(k8s_list)
  echo "$data" | jq -r '.items[]?.metadata.name // empty'
}

cmd_whoami() {
  local token
  token=$(get_token)
  local payload
  payload=$(echo "$token" | cut -d. -f2 | base64 -d 2>/dev/null || echo "$token" | cut -d. -f2 | base64url -d 2>/dev/null)
  echo "SA:        $(echo "$payload" | jq -r '."kubernetes.io/serviceaccount/name"')"
  echo "Namespace: $(echo "$payload" | jq -r '."kubernetes.io/serviceaccount/namespace"')"
  echo "UID:       $(echo "$payload" | jq -r '."kubernetes.io/serviceaccount.uid"')"
  echo "Expiry:    $(echo "$payload" | jq -r '.exp' | xargs -I{} date -u -d @{} +%Y-%m-%dT%H:%M:%SZ)"
}

cmd_login() {
  local duration="${1:-1h}"
  rm -f "$TOKEN_CACHE"
  get_token "$duration" >/dev/null
  echo "Refreshed token for $AGENT (duration: $duration)"
}

# ---- Main ----

case "${1:-help}" in
  export)   shift; cmd_export "$@" ;;
  list)     cmd_list ;;
  whoami)   cmd_whoami ;;
  login)    shift; cmd_login "$@" ;;
  help|--help|-h)
    cat <<'EOF'
k8s-secret — Read K8s secrets using SA identity

Usage:
  k8s-secret <name>              Read all keys
  k8s-secret <name> <key>        Read single key
  k8s-secret export <name>       Print as export VAR=value
  k8s-secret export <name> KEY   Export single key
  k8s-secret list                List agent secrets
  k8s-secret whoami              Show SA identity
  k8s-secret login [duration]    Refresh token

Environment:
  K8S_AGENT      ServiceAccount (default: readonly)
  K8S_NAMESPACE  Namespace (default: ai-agents)
  K8S_SA_TOKEN   Pre-existing token

Examples:
  k8s-secret gitlab-creds
  k8s-secret gitlab-creds read_token
  eval $(k8s-secret export gitlab-creds read_token)
  K8S_AGENT=k8s-readonly k8s-secret list
EOF
    ;;
  *) cmd_read "$@" ;;
esac
