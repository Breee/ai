#!/usr/bin/env bash
# k8s-kubeconfig: Generate a kubeconfig using a ServiceAccount token.
#
# Usage:
#   k8s-kubeconfig reader              # kubeconfig for reader SA
#   k8s-kubeconfig k8s-writer 30m      # 30-minute token
#   KUBECONFIG_OUT=/tmp/k.conf k8s-kubeconfig reader  # custom output
#
# The resulting kubeconfig can be passed to kubectl --kubeconfig=<file>
# or exported as KUBECONFIG.

set -euo pipefail

SA="${1:-}"
DURATION="${2:-1h}"
NS="ai-agents"
OUT="${KUBECONFIG_OUT:-}"
CLUSTER_NAME="kind-mastery-dev"

die() { echo "k8s-kubeconfig: $*" >&2; exit 1; }
[ -n "$SA" ] || die "Usage: k8s-kubeconfig <sa-name> [duration]"

# Verify SA exists
kubectl get sa "$SA" -n "$NS" >/dev/null 2>&1 \
  || die "SA '$SA' not found in namespace $NS"

# Get cluster server + CA
SERVER=$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}')
CA_DATA=$(kubectl config view --raw --minify -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')

# Generate short-lived token
TOKEN=$(kubectl create token "$SA" -n "$NS" --duration="$DURATION")

# Write kubeconfig
OUT="${OUT:-$HOME/.kube/k8s-${SA}.yaml}"
mkdir -p "$(dirname "$OUT")"

cat > "$OUT" <<EOF
apiVersion: v1
kind: Config
current-context: ${SA}@${CLUSTER_NAME}
clusters:
- cluster:
    server: ${SERVER}
    certificate-authority-data: ${CA_DATA}
  name: ${CLUSTER_NAME}
contexts:
- context:
    cluster: ${CLUSTER_NAME}
    user: ${SA}
  name: ${SA}@${CLUSTER_NAME}
users:
- name: ${SA}
  user:
    token: ${TOKEN}
EOF

echo "KUBECONFIG=$OUT"
echo "# Usage: kubectl --kubeconfig=$OUT get pods -n $NS"
echo "# Token expires in $DURATION"
