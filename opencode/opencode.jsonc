{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/repos/github.com/Breee/ai/opencode/AGENTS.md"],
  "model": "github-copilot/grok-4.6",
  "small_model": "github-copilot/mai-code-1.1-flash",

  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "groq": {
      "options": {
        "apiKey": "{env:GROQ_API_KEY}"
      }
    }
  },

  "agent": {
    "explore": {
      "model": "groq/llama-3.3-70b-versatile",
      "fallback_models": [
        "openrouter/google/gemma-4-31b-it:free",
        "github-copilot/mai-code-1.1-flash"
      ]
    },
    "general": {
      "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
      "fallback_models": [
        "groq/llama-3.3-70b-versatile",
        "github-copilot/grok-4.6"
      ]
    },
    "browser": {
      "model": "openrouter/poolside/laguna-xs-2.1:free",
      "fallback_models": [
        "groq/llama-3.1-8b-instant",
        "github-copilot/mai-code-1.1-flash"
      ]
    }
  },

  "mcp": {
    "mastery": {
      "type": "local",
      "command": ["python3", "tools/mastery-mcp/server.py"],
      "enabled": true,
      "environment": {
        "MASTERY_API": "http://localhost:8090",
        "MASTERY_KUBE_CONTEXT": "kind-mastery-dev",
        "MASTERY_MAILPIT": "http://localhost:8025"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    }
  },
  "tools": {
    "playwright*": false
  },
  "skills": {
    "paths": [
      "~/repos/github.com/Breee/ai/opencode/skills",
      "~/repos/github.com/Breee/ai/skills"
    ]
  },
  "references": {
    "opencode": {
      "path": "~/repos/github.com/Breee/ai/opencode",
      "description": "Personal opencode config, docs, agents, commands, and skills. Use for how this machine's opencode is set up."
    },
    "docs": {
      "path": "~/repos/github.com/Breee/ai/opencode/docs",
      "description": "Personal opencode documentation and conventions."
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-free-fleet",
    "opencode-runtime-fallback",
    "opencode-task-router"
  ]
}

