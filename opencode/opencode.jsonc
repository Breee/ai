{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/repos/github.com/Breee/ai/opencode/AGENTS.md"],
  "small_model": "github-copilot/mai-code-1.1-flash",
  "agent": {
    "explore": {
      "model": "github-copilot/mai-code-1.1-flash",
    },
  },
  "skills": {
    "paths": [
      "~/repos/github.com/Breee/ai/opencode/skills",
      "~/repos/github.com/Breee/ai/skills",
    ],
  },
  "references": {
    "opencode": {
      "path": "~/repos/github.com/Breee/ai/opencode",
      "description": "Personal opencode config, docs, agents, commands, and skills. Use for how this machine's opencode is set up.",
    },
    "docs": {
      "path": "~/repos/github.com/Breee/ai/opencode/docs",
      "description": "Personal opencode documentation and conventions.",
    },
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
}
