{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/repos/github.com/Breee/ai/opencode/AGENTS.md"],
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",

  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },

  "agent": {
    "explore": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "fallback_models": [
        "opencode/hy4-flash-free",
        "openrouter/nvidia/nemotron-3.5-lightning:free"
      ]
    },
    "general": {
      "model": "opencode/deepseek-v4.1-flash-free",
      "fallback_models": [
        "opencode/mimo-v2.6-flash-free",
        "opencode/hy4-flash-free"
      ]
    },
    "browser": {
      "model": "github-copilot/claude-haiku-4.5",
      "fallback_models": []
    }
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["/usr/local/bin/npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "gitlab": {
      "type": "remote",
      "url": "https://gitlab.com/api/v4/mcp",
      "oauth": {},
      "enabled": true
    }
  },
  "skills": {
    "paths": [
      "~/repos/github.com/Breee/ai/opencode/skills",
      "~/repos/github.com/Breee/ai/skills"
    ]
  },
  "references": {
    "opencode": {
      "path": "~/repos/github.com/Breee/ai/opencode",
      "description": "Personal opencode config, docs, agents, commands, and skills. Use for how this machine's opencode is set up."
    },
    "docs": {
      "path": "~/repos/github.com/Breee/ai/opencode/docs",
      "description": "Personal opencode documentation and conventions."
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-runtime-fallback"
  ]
}

