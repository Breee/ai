{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/repos/github.com/Breee/ai/opencode/AGENTS.md"],
  "model": "opencode/mimo-v2.5-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",

  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },

  "agent": {
    "explore": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "fallback_models": [
        "opencode/north-mini-code-free",
        "openrouter/cohere/north-mini-code:free"
      ]
    },
    "general": {
      "model": "opencode/mimo-v2.5-free",
      "fallback_models": [
        "opencode/nemotron-3-ultra-free",
        "opencode/north-mini-code-free"
      ]
    },
    "browser": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "fallback_models": [
        "opencode/north-mini-code-free",
        "openrouter/cohere/north-mini-code:free"
      ]
    }
  },

  "mcp": {
    "mastery": {
      "type": "local",
      "command": ["python3", "tools/mastery-mcp/server.py"],
      "enabled": true,
      "environment": {
        "MASTERY_API": "http://localhost:8090",
        "MASTERY_KUBE_CONTEXT": "kind-mastery-dev",
        "MASTERY_MAILPIT": "http://localhost:8025"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    }
  },
  "tools": {
    "playwright*": false
  },
  "skills": {
    "paths": [
      "~/repos/github.com/Breee/ai/opencode/skills",
      "~/repos/github.com/Breee/ai/skills"
    ]
  },
  "references": {
    "opencode": {
      "path": "~/repos/github.com/Breee/ai/opencode",
      "description": "Personal opencode config, docs, agents, commands, and skills. Use for how this machine's opencode is set up."
    },
    "docs": {
      "path": "~/repos/github.com/Breee/ai/opencode/docs",
      "description": "Personal opencode documentation and conventions."
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-free-fleet",
    "opencode-runtime-fallback",
    "opencode-task-router",
    "opencode-scheduler"
  ]
}

